# Root Docker Compose environment file.
# Copy this file to .env and replace every required value before starting.

# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public address used by the browser. For LAN-only access, use the server's
# LAN URL, for example http://192.168.1.20:8080.
CORS_ORIGINS=http://localhost:8080
DASHBOARD_PORT=8080

# Flask and JWT secrets. Generate each independently:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret

# Fernet key used to encrypt stored brokerage credentials and bank numbers.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key

# Application defaults
SCHEDULER_ENABLED=true
SYNC_INTERVAL_HOURS=12
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE=database
MAX_UPLOAD_BYTES=10485760

# Optional integrations
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Celery settings. PDF parsing remains synchronous when unset.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0