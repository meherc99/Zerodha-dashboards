# Flask
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000

# Replace both placeholders with different, high-entropy values.
# Generate each with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Database
# SQLite development database (resolved under backend/instance by Flask):
DATABASE_URL=sqlite:///zerodha_dashboard.db
# PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/zerodha_dashboard

# Credential encryption
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable or stored Kite credentials cannot be decrypted.
ENCRYPTION_KEY=

# Scheduler
SCHEDULER_ENABLED=true
SYNC_INTERVAL_HOURS=12

# Browser access and uploads
# Use exact trusted origins, separated by commas. Never use * in production.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=10485760
RATELIMIT_ENABLED=true
# Use "database" in production so counters survive restarts and span workers.
RATELIMIT_STORAGE=memory

# Optional integrations
# Required only for live US quote retrieval.
FINNHUB_API_KEY=
# Required only for AI-assisted bank-statement parsing; configure one provider.
# When set, fallback_to_ai() in pdf_parser_service.py and AI categorization
# in transaction_categorization_service.py will be available.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Background job queue (optional – recommended for production)
# When unset, PDF parsing runs synchronously in the request handler.
# Celery requires a broker (Redis recommended) and a result backend.
# Start workers with: celery -A run.celery worker --loglevel=info
#
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
